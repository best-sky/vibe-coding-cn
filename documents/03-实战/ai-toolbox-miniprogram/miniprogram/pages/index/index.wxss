.page {
  height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.fixed-header {
  background: var(--color-bg-page);
  padding: 0 var(--page-padding);
  z-index: 100;
  flex-shrink: 0;
}

.status-bar-placeholder {
  height: var(--status-bar-height, 44px);
  width: 100%;
}

.scroll {
  flex: 1;
  box-sizing: border-box;
  height: 0;
  width: 100%;
}

.scroll-content-padding {
  padding: 0 var(--page-padding) 32rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 32rpx;
  margin-bottom: var(--space-md);
}

.page-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--color-text-title);
  line-height: 1.3;
}

.search-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  padding: 0 32rpx;
  margin-bottom: 30rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-title);
}

.search-placeholder {
  color: var(--color-text-placeholder);
}

.category-block {
  margin-bottom: var(--space-xl);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-title);
  margin-bottom: var(--space-md);
  display: block;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-md);
}

.tool-card {
  display: flex;
  flex-direction: column;
  padding: 36rpx 28rpx;
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-normal) var(--ease-spring), box-shadow var(--duration-normal) var(--ease-out);
  position: relative;
  overflow: hidden;
}

.tool-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-xs);
}

.tool-card-placeholder {
  background: transparent;
  box-shadow: none;
  pointer-events: none;
}

.tool-icon-img {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 20rpx;
  transition: transform var(--duration-slow) var(--ease-spring);
}

.tool-card:active .tool-icon-img {
  transform: scale(1.15);
}

.tool-title {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-title);
  margin-bottom: 6rpx;
  line-height: 1.3;
}

.tool-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.tool-ai-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  letter-spacing: 2rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-placeholder);
}

.safe-gap {
  height: 96rpx;
}
