<view class="page">
  <scroll-view class="scroll" scroll-y>
    <view class="header-row">
      <view class="greeting-wrap">
        <text class="greeting-title">早上好，欢迎使用智藏</text>
        <text class="greeting-sub">今天也来高效完成任务</text>
      </view>
      <view class="avatar"></view>
    </view>

    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="输入你想使用的工具..."
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>

    <scroll-view class="category-row" scroll-x>
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="chip {{activeCategory === item.key ? 'chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <scroll-view class="carousel" scroll-x>
      <view wx:for="{{banners}}" wx:key="id" class="banner-item">
        <image mode="aspectFill" class="banner-image" src="{{item.image}}"></image>
        <view class="banner-mask">
          <text class="banner-title">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{recentTools.length}}" class="recent-wrap">
      <text class="section-title">最近使用</text>
      <view class="recent-list">
        <view
          wx:for="{{recentTools}}"
          wx:key="id"
          class="recent-item"
          data-path="{{item.path}}"
          data-id="{{item.id}}"
          bindtap="onToolTap"
        >
          <text class="recent-icon">{{item.icon}}</text>
          <text class="recent-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <text class="section-title tool-title">推荐工具</text>
    <view class="tool-grid">
      <view
        wx:for="{{filteredTools}}"
        wx:key="id"
        class="tool-card"
        data-path="{{item.path}}"
        data-id="{{item.id}}"
        bindtap="onToolTap"
      >
        <view class="tool-head">
          <text class="tool-icon">{{item.icon}}</text>
          <text wx:if="{{item.usageCount > 0}}" class="tool-badge">使用 {{item.usageCount}}</text>
        </view>
        <text class="tool-name">{{item.name}}</text>
        <text class="tool-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="safe-gap"></view>
  </scroll-view>
</view>
