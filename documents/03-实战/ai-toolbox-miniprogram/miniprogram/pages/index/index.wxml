<view class="page">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="header-row">
      <text class="page-title">AI 工具箱</text>
    </view>
    <view class="search-wrap">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit"></image>
      <input
        class="search-input"
        placeholder="搜索工具..."
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="scroll-content-padding">
      <view class="category-block" wx:for="{{filteredCategories}}" wx:key="key">
        <text class="section-title">{{item.name}}</text>
        
        <view class="tool-grid">
          <view
            wx:for="{{item.tools}}"
            wx:key="id"
            wx:for-item="tool"
            class="tool-card"
            data-path="{{tool.path}}"
            data-id="{{tool.id}}"
            bindtap="onToolTap"
          >
            <image class="tool-icon-img" src="/assets/icons/{{tool.icon}}.svg" mode="aspectFit"></image>
            <text wx:if="{{tool.category !== 'all'}}" class="tool-ai-tag">AI</text>
            <text class="tool-title">{{tool.name}}</text>
            <text class="tool-desc">{{tool.desc}}</text>
          </view>
          
          <!-- 占位符，如果工具数量是单数，保持栅格排版整齐 -->
          <view wx:if="{{item.tools.length % 2 !== 0}}" class="tool-card tool-card-placeholder"></view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{filteredCategories.length === 0}}">
        <text class="empty-text">没有找到相关工具</text>
      </view>

      <view class="safe-gap"></view>
    </view>
  </scroll-view>
</view>
