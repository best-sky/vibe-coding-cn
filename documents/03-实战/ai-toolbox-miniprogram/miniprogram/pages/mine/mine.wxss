.page {
  min-height: 100vh;
  background: #fafafa;
}

.content {
  padding: 96rpx 40rpx 32rpx;
}

.title {
  display: block;
  font-size: 64rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.profile-card {
  margin-top: 20rpx;
  min-height: 280rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 32rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #d4d4d4;
}

.profile-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.desc {
  font-size: 24rpx;
  color: #737373;
}

.count {
  font-size: 24rpx;
  color: #171717;
}

.menu-card {
  margin-top: 16rpx;
  min-height: 176rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 8rpx;
  display: block;
  font-size: 24rpx;
  color: #737373;
}

.arrow {
  font-size: 44rpx;
  color: #a3a3a3;
}

.recent-title {
  margin-top: 28rpx;
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.recent-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recent-item {
  min-height: 128rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.recent-icon {
  font-size: 38rpx;
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recent-name {
  font-size: 28rpx;
  color: #171717;
  font-weight: 600;
}

.recent-desc {
  font-size: 22rpx;
  color: #737373;
}

.empty {
  margin-top: 12rpx;
  color: #a3a3a3;
  font-size: 24rpx;
}
