<view class="page">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="header-row">
      <text class="page-title">我的</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="scroll-content">
      <view class="profile-card">
        <button wx:if="{{!avatarUrl}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onGotAvatar">
          <view class="avatar avatar-placeholder">
            <text class="avatar-text">登录</text>
          </view>
        </button>
        <image wx:else class="avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="onGotAvatarTap"></image>

        <view class="profile-text">
          <view wx:if="{{showNickInput}}" class="nick-input-wrap">
            <input
              type="nickname"
              class="nick-input"
              placeholder="请输入昵称"
              value="{{nickName}}"
              bindchange="onNickNameChange"
              bindblur="onNickNameBlur"
              focus="{{showNickInput}}"
            />
          </view>
          <text wx:else class="name" bindtap="onNameTap">{{nickName}}</text>
          <text class="desc">{{profileDesc}}</text>
          <text class="count">累计使用 {{totalUseCount}} 次</text>
        </view>
      </view>

      <view class="menu-card" data-type="about" bindtap="onTapItem">
        <view>
          <text class="menu-title">关于</text>
          <text class="menu-desc">产品说明与版本信息</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="menu-card" data-type="feedback" bindtap="onTapItem">
        <view>
          <text class="menu-title">意见反馈</text>
          <text class="menu-desc">欢迎提交建议与问题</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <text class="recent-title">最近使用</text>
      <view wx:if="{{recentTools.length}}" class="recent-list">
        <view
          wx:for="{{recentTools}}"
          wx:key="id"
          class="recent-item"
          data-path="{{item.path}}"
          bindtap="onGoTool"
        >
          <image class="recent-icon-img" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"></image>
          <view class="recent-info">
            <text class="recent-name">{{item.name}}</text>
            <text class="recent-desc">{{item.desc}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view wx:else class="empty">暂无使用记录，去首页体验工具吧</view>

      <view class="safe-gap"></view>
    </view>
  </scroll-view>
</view>
