<view class="page safe-area-bottom">
  <view class="content">
    <text class="title">我的</text>

    <view class="profile-card card">
      <view class="avatar"></view>
      <view class="profile-text">
        <text class="name">{{profileName}}</text>
        <text class="desc">{{profileDesc}}</text>
        <text class="count">累计使用 {{totalUseCount}} 次</text>
      </view>
    </view>

    <view class="menu-card card" data-type="record" bindtap="onTapItem">
      <view>
        <text class="menu-title">使用记录</text>
        <text class="menu-desc">查看最近使用的工具</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-card card" data-type="about" bindtap="onTapItem">
      <view>
        <text class="menu-title">关于</text>
        <text class="menu-desc">产品说明与版本信息</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-card card" data-type="feedback" bindtap="onTapItem">
      <view>
        <text class="menu-title">意见反馈</text>
        <text class="menu-desc">欢迎提交建议与问题</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <text class="recent-title">最近使用</text>
    <view wx:if="{{recentTools.length}}" class="recent-list">
      <view
        wx:for="{{recentTools}}"
        wx:key="id"
        class="recent-item card"
        data-path="{{item.path}}"
        bindtap="onGoTool"
      >
        <text class="recent-icon">{{item.icon}}</text>
        <view class="recent-info">
          <text class="recent-name">{{item.name}}</text>
          <text class="recent-desc">{{item.desc}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
    <view wx:else class="empty">暂无使用记录，去首页体验工具吧</view>
  </view>
</view>
