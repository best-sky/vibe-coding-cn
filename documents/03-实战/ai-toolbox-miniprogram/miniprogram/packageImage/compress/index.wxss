.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
}

.back {
  font-size: 48rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.title {
  display: block;
  font-size: 60rpx;
  line-height: 84rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #737373;
  font-size: 28rpx;
}

.preview {
  margin-top: 24rpx;
  height: 520rpx;
  border-radius: 56rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-hint {
  color: #737373;
  font-size: 30rpx;
}

.size-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
}

.size-text {
  font-size: 24rpx;
  color: #525252;
}

.label {
  margin-top: 24rpx;
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.quality-row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.quality-item {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #404040;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quality-item.active {
  background: #171717;
  color: #ffffff;
  font-weight: 600;
}

.status {
  margin-top: 20rpx;
  color: #3b82f6;
  font-size: 24rpx;
}

.bottom-btn {
  margin-top: 120rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 750px;
}
