.page {
  min-height: 100vh;
  padding: 0 var(--page-padding) 32rpx;
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.preview {
  margin-top: var(--space-md);
  height: 600rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-input);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-hint {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.watermark {
  width: 172rpx;
  height: 172rpx;
  border-radius: 86rpx;
  background: #e5e5e5;
  color: var(--color-primary);
  font-size: var(--font-lg);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-title);
}

.color-row {
  margin-top: var(--space-sm);
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.color-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  transition: transform var(--duration-fast) var(--ease-spring);
}

.color-dot:active {
  transform: scale(0.9);
}

.dot-active {
  border: 4rpx solid var(--color-primary);
  box-sizing: border-box;
}

.size-row {
  margin-top: var(--space-sm);
  display: flex;
  gap: var(--space-sm);
}

.size-item {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  font-size: var(--font-base);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--duration-fast) ease;
}

.size-item.active {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.status {
  margin-top: var(--space-md);
  color: var(--color-primary);
  font-size: var(--font-sm);
  text-align: center;
}

.bottom-btn {
  margin-top: var(--space-xl);
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 840px;
}
