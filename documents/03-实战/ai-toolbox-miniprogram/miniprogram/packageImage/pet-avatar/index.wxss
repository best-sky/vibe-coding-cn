.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

/* Chip 选择 */
.chip-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 68rpx;
  padding: 0 32rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  transition: all var(--duration-fast) ease;
}

.chip:active {
  transform: scale(0.95);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

/* 输入框 */
.input-wrap {
  margin-top: 16rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.input {
  width: 100%;
  height: 140rpx;
  font-size: var(--font-sm);
  color: var(--color-text-title);
  line-height: 1.6;
}

.placeholder {
  color: var(--color-text-placeholder);
  font-size: var(--font-sm);
}

/* 风格选择网格 */
.style-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.style-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-input);
  border: 4rpx solid transparent;
  transition: all var(--duration-fast) ease;
}

.style-card:active {
  transform: scale(0.95);
}

.style-active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.style-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.style-label {
  font-size: var(--font-xs);
  color: var(--color-text-body);
  text-align: center;
}

.style-active .style-label {
  color: var(--color-primary);
  font-weight: 600;
}

/* 按钮 */
.btn-row {
  margin-top: var(--space-lg);
}

.action-btn {
  width: 100%;
  margin: 0;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 生成结果 */
.result-card {
  margin-top: 16rpx;
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  text-align: center;
}

.result-img {
  width: 100%;
  max-height: 640rpx;
  border-radius: var(--radius-md);
}

.result-actions {
  margin-top: var(--space-md);
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.action-pill {
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  font-size: var(--font-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--duration-fast) ease;
}

.action-pill:active {
  transform: scale(0.95);
  background: var(--color-border);
}

/* 错误提示 */
.error-wrap {
  margin-top: var(--space-md);
  padding: 24rpx;
  background: rgba(239, 68, 68, 0.06);
  border-radius: var(--radius-md);
}

.error-text {
  font-size: var(--font-sm);
  color: var(--color-error);
  line-height: 1.5;
}

/* 底部声明 */
.disclaimer {
  margin-top: var(--space-lg);
  padding: 0 8rpx;
}

.disclaimer-text {
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
  line-height: 1.6;
}


