.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
}

.back {
  font-size: 48rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.title {
  display: block;
  font-size: 60rpx;
  line-height: 84rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #737373;
  font-size: 28rpx;
}

.label {
  margin-top: 24rpx;
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.input-wrap {
  margin-top: 16rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 24rpx;
}

.input {
  width: 100%;
  height: 184rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #171717;
}

.placeholder {
  color: #a3a3a3;
}

.chip-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  height: 72rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #404040;
  font-size: 26rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

.chip-active {
  background: #171717;
  color: #ffffff;
}

.result-card {
  margin-top: 16rpx;
  padding: 28rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-title {
  font-size: 30rpx;
  color: #171717;
  font-weight: 600;
}

.copy-btn {
  font-size: 24rpx;
  color: #404040;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.result-body {
  margin-top: 16rpx;
  display: block;
  white-space: pre-wrap;
  line-height: 1.8;
  font-size: 28rpx;
  color: #171717;
  min-height: 200rpx;
}

.status {
  margin-top: 20rpx;
  color: #3b82f6;
  font-size: 24rpx;
}

.bottom-btn {
  margin-top: 36rpx;
}
