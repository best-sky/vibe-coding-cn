.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.chip-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 72rpx;
  padding: 0 28rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

.input-wrap {
  margin-top: var(--space-md);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.input {
  width: 100%;
  height: 200rpx;
  font-size: var(--font-base);
  color: var(--color-text-title);
  line-height: 1.6;
}

.placeholder {
  color: var(--color-text-placeholder);
}

.btn-row {
  margin-top: var(--space-md);
}

.action-btn {
  width: 100%;
  margin: 0;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.result-card {
  margin-top: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-white);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
}

.result-text {
  font-size: var(--font-base);
  color: var(--color-text-body);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.thinking {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 0;
}

.thinking__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-text-placeholder);
  animation: waveFloat 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.thinking__dot:nth-child(1) { animation-delay: 0s; }
.thinking__dot:nth-child(2) { animation-delay: 0.2s; }
.thinking__dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes waveFloat {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.35;
  }
  40% {
    transform: translateY(-14rpx) scale(1.2);
    opacity: 1;
  }
}

.copy-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.copy-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  font-size: var(--font-xs);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty {
  color: var(--color-text-placeholder);
  font-size: var(--font-sm);
  text-align: center;
  margin-top: var(--space-xl);
}
