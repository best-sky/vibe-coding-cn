<view class="page safe-area-bottom">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-row" bindtap="onBack">
      <image class="back-icon" src="/assets/icons/arrow-left.svg" mode="aspectFit"></image>
    </view>

    <text class="title">AI 解梦</text>
    <text class="sub">输入梦境内容，AI 为你解读梦的含义</text>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="scroll-content">
      <text class="label">解读风格</text>
      <view class="chip-row">
        <view
          wx:for="{{styles}}"
          wx:key="*this"
          class="chip {{activeStyle === item ? 'chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectStyle"
        >
          {{item}}
        </view>
      </view>

      <view class="input-wrap">
        <textarea
          class="input"
          maxlength="-1"
          placeholder="描述你的梦境，越详细解读越准确。例如：我梦见自己在一片大海上飞翔，海面波光粼粼..."
          placeholder-class="placeholder"
          value="{{dreamContent}}"
          bindinput="onInput"
        ></textarea>
      </view>

      <view class="btn-row">
        <view class="primary-btn action-btn {{loading ? 'btn-disabled' : ''}}" bindtap="onGenerate">
          {{loading ? '解读中...' : '开始解梦'}}
        </view>
      </view>

      <block wx:if="{{resultText}}">
        <text class="label">解梦结果</text>
        <view class="result-card">
          <text class="result-text">{{resultText}}</text>
          <view wx:if="{{isGenerating}}" class="thinking">
            <view class="thinking__dot"></view>
            <view class="thinking__dot"></view>
            <view class="thinking__dot"></view>
          </view>
        </view>
        <view class="copy-row" wx:if="{{!isGenerating}}">
          <view class="copy-btn" bindtap="onCopyResult">复制结果</view>
        </view>
      </block>

      <view wx:if="{{!resultText && !loading}}" class="empty">描述你的梦境，让 AI 为你解读</view>
    </view>
  </scroll-view>
</view>
