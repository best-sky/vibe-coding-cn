<view class="page safe-area-bottom">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-row" bindtap="onBack">
      <image class="back-icon" src="/assets/icons/arrow-left.svg" mode="aspectFit"></image>
    </view>

    <text class="title">AI 网名生成</text>
    <text class="sub">选择风格和平台，生成个性网名</text>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="scroll-content">
      <text class="label">风格</text>
      <view class="chip-row">
        <view
          wx:for="{{styles}}"
          wx:key="*this"
          class="chip {{activeStyle === item ? 'chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectStyle"
        >
          {{item}}
        </view>
      </view>

      <text class="label">平台</text>
      <view class="chip-row">
        <view
          wx:for="{{platforms}}"
          wx:key="*this"
          class="chip {{activePlatform === item ? 'chip-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectPlatform"
        >
          {{item}}
        </view>
      </view>

      <view class="input-wrap">
        <input
          class="input"
          placeholder="可选：输入关键词或兴趣爱好"
          placeholder-class="placeholder"
          value="{{keyword}}"
          bindinput="onInput"
        />
      </view>

      <view class="btn-row">
        <view class="primary-btn action-btn {{loading ? 'btn-disabled' : ''}}" bindtap="onGenerate">
          {{loading ? '生成中...' : '生成网名'}}
        </view>
      </view>

      <block wx:if="{{nicknames.length > 0}}">
        <text class="label">推荐网名</text>
        <view class="name-list">
          <view wx:for="{{nicknames}}" wx:key="name" class="name-card">
            <view class="name-info">
              <text class="name-text">{{item.name}}</text>
              <text class="name-desc" wx:if="{{item.inspiration}}">{{item.inspiration}}</text>
            </view>
            <view class="copy-btn" data-name="{{item.name}}" bindtap="onCopyName">复制</view>
          </view>
        </view>
      </block>

      <view wx:if="{{!nicknames.length && !loading}}" class="empty">选择风格和平台，点击生成</view>
    </view>
  </scroll-view>
</view>
