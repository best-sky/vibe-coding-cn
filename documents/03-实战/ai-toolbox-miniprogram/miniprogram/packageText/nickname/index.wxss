.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.chip-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 72rpx;
  padding: 0 28rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

.input-wrap {
  margin-top: var(--space-md);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.input {
  width: 100%;
  font-size: var(--font-base);
  color: var(--color-text-title);
}

.placeholder {
  color: var(--color-text-placeholder);
}

.btn-row {
  margin-top: var(--space-md);
}

.action-btn {
  width: 100%;
  margin: 0;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.name-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name-card {
  border-radius: var(--radius-lg);
  background: var(--color-bg-white);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.name-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  margin-right: 16rpx;
}

.name-text {
  font-size: var(--font-lg);
  color: var(--color-text-title);
  font-weight: 700;
}

.name-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.copy-btn {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  font-size: var(--font-xs);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty {
  color: var(--color-text-placeholder);
  font-size: var(--font-sm);
  text-align: center;
  margin-top: var(--space-xl);
}
