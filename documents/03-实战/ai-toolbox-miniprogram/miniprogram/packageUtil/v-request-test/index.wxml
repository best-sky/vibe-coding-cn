<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">←</text>
    </view>
    <text class="nav-title">v-request 测试</text>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="content">
      <view class="tip-card" wx:if="{{showTip}}">
        <text class="tip-text">首次使用需在云开发控制台将 v-request 云函数超时时间改为 60 秒（默认仅 3 秒）</text>
        <text class="tip-close" bindtap="closeTip">知道了</text>
      </view>

      <view class="card">
        <text class="card-label">接口地址</text>
        <text class="card-url">{{apiUrl}}</text>
        <text class="card-meta">请求方式：GET　|　返回格式：HTML</text>
      </view>

      <button class="primary-btn" bindtap="fetchYiyan" disabled="{{loading}}">
        {{loading ? '请求中...' : '发起请求'}}
      </button>

      <view class="result-card" wx:if="{{result || error}}">
        <text class="result-label">{{error ? '错误信息' : '返回结果'}}</text>

        <view class="result-box {{error ? 'result-error' : ''}}">
          <text class="result-text" user-select>{{error || result}}</text>
        </view>

        <view class="meta-row" wx:if="{{statusCode}}">
          <text class="meta-item">状态码：{{statusCode}}</text>
          <text class="meta-item">耗时：{{costTime}}ms</text>
        </view>
      </view>

      <view class="result-card" wx:if="{{parsedText}}">
        <text class="result-label">解析后文本</text>
        <view class="parsed-box">
          <text class="parsed-text" user-select>{{parsedText}}</text>
        </view>
      </view>

      <view class="safe-gap"></view>
    </view>
  </scroll-view>
</view>
