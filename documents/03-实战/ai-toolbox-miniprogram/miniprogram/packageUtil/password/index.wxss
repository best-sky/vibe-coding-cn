.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.password-card {
  margin-top: var(--space-md);
  background: var(--color-text-title);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
}

.password-text {
  display: block;
  font-size: 36rpx;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  color: #FFFFFF;
  word-break: break-all;
  line-height: 1.6;
  letter-spacing: 2rpx;
}

.password-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--duration-fast) ease;
}

.icon-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

.icon-text {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}

.copy-btn.copied {
  background: rgba(34, 197, 94, 0.3);
}

.copy-btn.copied .icon-text {
  color: #4ADE80;
}

.strength-row {
  margin-top: var(--space-md);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.strength-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.strength-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-bg-input);
  overflow: hidden;
}

.strength-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width var(--duration-normal) var(--ease-out), background var(--duration-normal) ease;
}

.strength-text {
  font-size: var(--font-sm);
  font-weight: 600;
  flex-shrink: 0;
  min-width: 60rpx;
  text-align: right;
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.chip-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-width: 100rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

.toggle-list {
  margin-top: 16rpx;
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.toggle-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.toggle-item:last-child {
  border-bottom: none;
}

.toggle-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.toggle-title {
  font-size: var(--font-base);
  color: var(--color-text-title);
}

.toggle-sample {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.toggle-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--color-bg-input);
  position: relative;
  transition: background var(--duration-fast) ease;
  flex-shrink: 0;
}

.switch-on {
  background: var(--color-text-title);
}

.switch-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-spring);
}

.switch-on .switch-thumb {
  transform: translateX(40rpx);
}

.history-list {
  margin-top: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.history-item:last-child {
  border-bottom: none;
}

.history-pw {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.history-copy {
  font-size: var(--font-xs);
  color: var(--color-primary);
  flex-shrink: 0;
}
