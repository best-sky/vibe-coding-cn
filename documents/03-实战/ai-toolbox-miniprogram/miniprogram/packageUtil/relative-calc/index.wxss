.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: var(--space-md);
}

.chip {
  height: 68rpx;
  padding: 0 32rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
  transition: all var(--duration-fast) ease;
}

.chip:active {
  transform: scale(0.95);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

.chain-card {
  margin-top: var(--space-md);
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  min-height: 88rpx;
}

.chain-prefix {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.chain-step {
  font-size: var(--font-base);
  color: var(--color-primary);
  font-weight: 600;
}

.chain-arrow {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.chain-empty {
  margin-top: var(--space-md);
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  text-align: center;
}

.chain-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

.result-card {
  margin-top: var(--space-md);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  text-align: center;
}

.highlight-card {
  background: var(--color-text-title);
}

.result-label {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.6);
}

.result-total {
  display: block;
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.result-sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.5);
}

.ineligible-card {
  background: var(--color-bg-input);
}

.ineligible-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.label {
  margin-top: var(--space-lg);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.btn-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.rel-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-md);
  background: var(--color-bg-white);
  color: var(--color-text-body);
  box-shadow: var(--shadow-xs);
  transition: all var(--duration-fast) ease;
}

.rel-btn:active {
  transform: scale(0.92);
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.rel-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.action-row {
  margin-top: var(--space-lg);
  display: flex;
  gap: 20rpx;
}

.half-btn {
  flex: 1;
  width: auto;
  margin: 0;
}
