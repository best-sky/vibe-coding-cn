.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-page);
}

.fixed-header {
  flex-shrink: 0;
  padding: 0 var(--page-padding) var(--space-md);
  background: var(--color-bg-page);
  z-index: 2;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding: 0 var(--page-padding) calc(env(safe-area-inset-bottom) + 32rpx);
}

.status-bar-placeholder {
  width: 100%;
}

.nav-row {
  height: 80rpx;
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  margin-left: -24rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 24rpx;
}

.title {
  display: block;
  font-size: var(--font-xl);
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-title);
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.input-wrap {
  margin-top: var(--space-md);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.input {
  width: 100%;
  height: 160rpx;
  font-size: var(--font-base);
  color: var(--color-text-title);
  line-height: 1.6;
}

.placeholder {
  color: var(--color-text-placeholder);
}

.label {
  margin-top: var(--space-md);
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-title);
}

.chip-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-width: 132rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-input);
  color: var(--color-text-body);
}

.chip-active {
  background: var(--color-text-title);
  color: #ffffff;
}

.color-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.color-dot-active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx var(--color-primary-bg);
}

.transparent-dot {
  position: relative;
  border: 2rpx dashed var(--color-border);
}

.transparent-dot::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 26rpx;
  width: 40rpx;
  height: 2rpx;
  background: #ef4444;
  transform: rotate(-45deg);
}

.preview-wrap {
  margin-top: var(--space-md);
  position: relative;
  height: 560rpx;
  border-radius: var(--radius-lg);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-canvas {
  width: 560rpx;
  height: 560rpx;
}

.preview-hint {
  position: absolute;
  color: var(--color-text-placeholder);
  font-size: var(--font-sm);
}

.status {
  margin-top: var(--space-sm);
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.btn-row {
  margin-top: var(--space-lg);
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  width: auto;
  margin: 0;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 200px;
  height: 200px;
}
